# TEMPLATE — copy to systems/<nickname>.env and fill in. NEVER put the password here.
SAP_URL=https://<host>:<port-only-if-needed>
SAP_CLIENT=<client>
SAP_USER=<user>

# --- optional flags (uncomment as needed) ---
# SAP_INSECURE=true             # only for an untrusted lab TLS cert
# SAP_ALLOW_DATA_PREVIEW=true   # allow table / CDS data preview
# SAP_ALLOW_FREE_SQL=true       # allow SAPQuery (read-only free SQL)

# --- write-gating (set INLINE per write instead, so they don't linger) ---
# SAP_ALLOW_WRITES=true
# SAP_ALLOWED_PACKAGES=<PKG1,PKG2>
# SAP_ALLOWED_TRANSPORTS=<TR1,TR2>
# SAP_ALLOW_TRANSPORT_WRITES=true

# NOTE on RISE / S/4HANA Cloud: use https://<host> on port 443.
#      Do NOT append :44300 — it does not pass the RISE load balancer.
# Password: run  Set-Arc1Secret <nickname>  (Windows)  — never store it in this file.
